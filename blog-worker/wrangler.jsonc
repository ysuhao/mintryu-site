{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mintryu-blog",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "BLOG_DATA",
      "id": "9c3ec924998d4123bd9e7be5ef8704a1"
    }
  ],
  "routes": [
    { "pattern": "mintryu.com/blog*", "zone_name": "mintryu.com" },
    { "pattern": "mintryu.com/admin*", "zone_name": "mintryu.com" },
    { "pattern": "mintryu.com/api/blog*", "zone_name": "mintryu.com" },
    { "pattern": "mintryu.com/media*", "zone_name": "mintryu.com" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
